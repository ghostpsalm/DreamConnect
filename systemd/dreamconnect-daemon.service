[Unit]
Description=dreamconnect runtime daemon (Wayland capture/input bridge for ScreenConnect)
Documentation=https://github.com/ghostpsalm/DreamConnect
# Needs a GNOME/Wayland session (Mutter D-Bus, PipeWire) to be up. @SESSION_UNIT@
# is substituted by install.sh: graphical-session.target for a real logged-in
# session, or dreamconnect-backstage.service for the headless backstage shell,
# which never reaches graphical-session.target.
After=@SESSION_UNIT@
PartOf=@SESSION_UNIT@
# Retry forever: never let a fast crash-loop trip the default start rate-limit
# (5 starts / 10s) and leave the bridge permanently stopped on an unattended box.
StartLimitIntervalSec=0

[Service]
Type=simple
# @INSTALL_DIR@ and @DAEMON_ARGS@ are substituted by install.sh — the latter is
# `--monitor <connector>` for physical capture, `--virtual <WxH>` for backstage.
ExecStart=/usr/bin/python3 @INSTALL_DIR@/runtime/dreamconnect_daemon.py --shm @SHM_PATH@ @DAEMON_ARGS@
Restart=always
RestartSec=2
# Owner-only files: the root SC JVM reads the shm/socket via DAC override, so
# other local users can't scrape the screen or inject input.
UMask=0077

[Install]
WantedBy=@SESSION_UNIT@
